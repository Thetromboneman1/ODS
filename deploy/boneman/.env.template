# Non-secret Boneman ODS deployment settings.
# deploy/boneman/install.sh writes secrets to dream-server/.env with mode 0600.

COMPOSE_PROJECT_NAME=ods-boneman
BIND_ADDRESS=127.0.0.1
DREAM_MODE=boneman
LLM_BACKEND=omlx
LLM_API_URL=http://litellm:4000
LLM_API_BASE_PATH=/v1
LLM_MODEL=mlx-community--gemma-4-31b-it-4bit
GGUF_FILE=
MODEL_PROFILE=gemma4
GPU_BACKEND=apple
HOST_RAM_GB=64

# Existing host oMLX runtime. Containers use host.docker.internal.
OMLX_HOST_URL=http://host.docker.internal:18080
OLLAMA_PORT=18080

# Conflict-free, loopback-only ODS surfaces.
WEBUI_PORT=3100
DASHBOARD_PORT=3101
DASHBOARD_API_PORT=3102
TOKEN_SPY_PORT=3105
LITELLM_PORT=4100
SEARXNG_PORT=8889

WEBUI_NAME=ODS Boneman
WEBUI_AUTH=true
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
ENABLE_IMAGE_GENERATION=false
TIMEZONE=America/Chicago
LANGFUSE_ENABLED=false

# Host agent is intentionally not installed by this additive profile.
DREAM_AGENT_HOST=host.docker.internal
DREAM_AGENT_PORT=7711

